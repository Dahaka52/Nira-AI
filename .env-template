OPENAI_API_KEY=<openai key like sk-proj-...>
GROQ_API_KEY=<groq api key like gsk_...>
GEMINI_API_KEY=<gemini api key like AIza...>
FISH_API_KEY=<fish api key>
AZURE_REGION=<azure region from https://gist.github.com/ausfestivus/04e55c7d80229069bf3bc75870630ec8 like eastus>
